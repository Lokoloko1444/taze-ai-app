{
  "name": "taze",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan --clear --port 8084",
    "start:go:clean": "expo start --go --lan --clear --port 8084",
    "start:dev": "expo start --dev-client --lan --clear --port 8084",
    "start:prod-sim": "node ./scripts/start-prod-sim.js",
    "build:web": "expo export --platform web --clear --output-dir dist && node ./scripts/patch-web-root-html.js",
    "cf:build": "npm run build:web",
    "cf:prepare": "node ./scripts/prepare-cloudflare-assets.js && node ./scripts/generate-root-html.js",
    "cf:deploy": "npm run build:web && npm run cf:prepare && wrangler deploy",
    "cf:whoami": "wrangler whoami",
    "start:server": "node server.js",
    "check:env": "node ./scripts/check-env.js",
    "check:readiness": "node ./scripts/go-live-readiness.js",
    "qa:baseline": "npm run check:env && npm run security:check && npm run check:readiness && npm run build:web",
    "qa:web": "playwright test",
    "qa:web:headed": "playwright test --headed",
    "smoke:server": "node ./scripts/smoke-server.js",
    "reset-project": "node ./scripts/reset-project.js",
    "security:check": "npm run lint && npm audit --audit-level=high",
    "eas:configure": "npx eas-cli build:configure",
    "eas:build:android": "npx eas-cli build --platform android --profile production",
    "eas:build:android:submit": "npx eas-cli build --platform android --profile production --auto-submit",
    "eas:submit:android": "npx eas-cli submit --platform android --profile production --latest --non-interactive",
    "eas:build:ios": "npx eas-cli build --platform ios --profile production",
    "eas:build:ios:submit": "npx eas-cli build --platform ios --profile production --auto-submit",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production --latest --non-interactive",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node ./scripts/start-web-safe.js",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "7.15.5",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.103.0",
    "@types/react": "~19.2.10",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.26",
    "expo-av": "~16.0.8",
    "expo-camera": "~55.0.19",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-router": "~55.0.16",
    "expo-screen-capture": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-server": "~55.0.11",
    "expo-speech": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "node": "^25.8.2",
    "openai": "^6.34.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-devtools": "^0.0.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "server.js": "^1.0.0",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "react-native-windows": "^0.83.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.98.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
  "private": true
}
