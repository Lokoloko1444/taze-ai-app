# Expo app (public runtime config)
# Never commit real secrets here. Use this file only as a template.
EXPO_PUBLIC_APP_URL=https://app.taze.to
EXPO_PUBLIC_API_URL=https://api.taze.to
# Optional fallback for readiness checks if the custom domain is temporarily unreachable.
LIVE_API_URL=https://taze-app.lgstudio144.workers.dev
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_ENABLE_INTERNAL_TOOLS=0
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
EXPO_PUBLIC_REQUIRE_LOGIN=0

# Server (Node / Express)
NODE_ENV=development
PORT=3000
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.2-mini

# CORS
CORS_ORIGINS=http://localhost:8084,http://localhost:3000,https://taze.to,https://www.taze.to,https://app.taze.to,https://admin.taze.to,https://scan.taze.to
RETURN_URL_ORIGINS=http://localhost:8084,http://localhost:3000,https://taze.to,https://www.taze.to,https://app.taze.to,https://admin.taze.to,https://scan.taze.to

# Supabase admin (server-side only)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe (server-side only)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Stripe Prices (create these in Stripe dashboard)
STRIPE_PRICE_BUSINESS_ESSENTIAL_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_ESSENTIAL_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_ESSENTIAL_YEAR=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_GROWTH_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_GROWTH_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_GROWTH_YEAR=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_SCALE_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_SCALE_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_SCALE_YEAR=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_ENTERPRISE_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_ENTERPRISE_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_BUSINESS_ENTERPRISE_YEAR=YOUR_PRICE_ID

STRIPE_PRICE_PERSONAL_BASIC_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_BASIC_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_BASIC_YEAR=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_PLUS_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_PLUS_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_PLUS_YEAR=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_PREMIUM_MONTH=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_PREMIUM_QUARTER=YOUR_PRICE_ID
STRIPE_PRICE_PERSONAL_PREMIUM_YEAR=YOUR_PRICE_ID

# Newsletter provider (Brevo)
BREVO_ENABLED=true
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_LIST_ID=YOUR_BREVO_LIST_ID
BREVO_SENDER_EMAIL=hello@taze.to
BREVO_SENDER_NAME=Taze
