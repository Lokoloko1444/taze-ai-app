{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./*"],
      "app/*": ["./app/*"],
      "assets/*": ["./assets/*"],
      "components/*": ["./components/*"],
      "constants/*": ["./constants/*"],
      "cloudflare/*": ["./cloudflare/*"],
      "hooks/*": ["./hooks/*"],
      "lib/*": ["./lib/*"],
      "scripts/*": ["./scripts/*"],
      "supabase/*": ["./supabase/*"],
      "types/*": ["./types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
