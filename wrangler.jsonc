{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taze-app",
  "main": "./cloudflare/worker.mjs",
  "tsconfig": "./cloudflare/tsconfig.json",
  "workers_dev": true,
  "compatibility_date": "2026-04-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "NODE_ENV": "production",
    "EXPO_PUBLIC_APP_URL": "https://app.taze.to",
    "EXPO_PUBLIC_API_URL": "https://api.taze.to",
    "EXPO_PUBLIC_DEMO_MODE": "false",
    "RIA_MODEL": "gpt-5.4-mini",
    "AI_MODEL": "gpt-5.4-mini",
    "TAZE_WORKER_VERSION": "edge-dispatch-v5",
    "CORS_ORIGINS": "https://taze.to,https://www.taze.to,https://demo.taze.to,https://platform.taze.to,https://app.taze.to,https://transport.taze.to,https://ai.taze.to,https://admin.taze.to,https://scan.taze.to,https://api.taze.to",
